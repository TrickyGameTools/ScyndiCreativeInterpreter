MODULE

VAR GewoonNiks = Lua.SCI_InitAPI(Lua.SCI_StateName,"Bank")

Void Kill(String Tag)
	Lua.Bank.Kill(Tag)
End

	

CLASS TBank

	READONLY STRING Tag
	INT Position = 0
		
	GET BOOL AutoDelete
		RETURN Prefixed(Tag,"***AUTO")
	END
		
	STATIC VAR Obtain(STRING _Tag)
		RETURN NEW TBank(-999,_Tag)
	END
		

	CONSTRUCTOR(INT _size,STRING _Tag="")
		if (_size==-999) && (_Tag!="")
			Tag = _Tag
			Return
		End
		if (_size<=16) 
			error("A bank must be at least 16 bytes")
		end		
		Tag = Lua.Bank.Create(_Tag,_size)
	END
	
	DESTRUCTOR
		IF AutoDelete
			Lua.Bank.Kill(Tag)
		END
	END
	
	STATIC VAR Load(string _E,string _Tag="")
		_GT:=Lua.Bank.Load(_E,_Tag)
		ret:=New TBank(-999,_GT)
		return ret
	END
	
	GET INT Size
		RETURN Lua.Bank.Size(Tag)
	END
	
	GET BOOL EOF
		Return Position>=Size
	END
	
	VOID Poke(INT ADDR,INT VALUE,INT BITS=8)
		Lua.Bank.Poke(Tag,ADDR,VALUE,BITS)
	END
	
	VOID PokeS8(Int ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,-8)
	END
	
	VOID PokeU8(INT ADDR,BYTE VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,8)
	END
	
	VOID PokeS16(Int ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,-16)
	END
	
	VOID PokeU16(INT ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,16)
	END
	
	VOID PokeS32(Int ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,-32)
	END
	
	VOID PokeU32(INT ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,32)
	END		
	
	VOID PokeS64(Int ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,-64)
	END
	
	VOID PokeU64(INT ADDR,INT VALUE)
		Lua.Bank.Poke(Tag,ADDR,VALUE,64)
	END		
	
	INT Peek(INT ADDR,INT BITS=8)
		RETURN Lua.Bank.Peek(Tag,ADDR,BITS)
	END
	
	BYTE PeekU8(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,8)
	END
	INT PeekS8(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,-8)
	END
	
	INT PeekU16(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,16)
	END
	INT PeekS16(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,-16)
	END
	
	INT PeekU32(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,32)
	END
	INT PeekS32(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,-32)
	END
	
	INT PeekU64(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,64)
	END
	INT PeekS64(INT ADDR)
		RETURN Lua.Bank.Peek(Tag,ADDR,-64)
	END
	
	VOID CLEAN()
		Lua.Bank.Clean(Tag)
	END
	
	BYTE ReadByte()		
		ret:=Ternary(EOF,0,self.PeekU8(Position))
		Position++
		RETURN ret
	END
	
	INT ReadInt32()
		ret:=Ternary(Position<Size-4,Self.PeekS32(Position))
		Position+=4
		Return Ret
	END
	
	STRING ReadString(Int Sz=0)
		Sz=Ternary(Sz==0,Self.ReadInt32(),Sz)
		Ret:=""
		FOR I=1,Sz
			Ret+=LString.Char(Self.ReadByte())
		END
		RETURN Ret
	END
	
	STRING ReadNullString(Int Sz=0)
		Ret:=""
		BOOL N=False
		WHILE SZ>0 && (!N)
			C:=Self.ReadByte()
			N=N||C<=0
			IF !N
				Ret+=LString.Char(Self.ReadByte())
			END
			SZ=math.max(0,SZ-1)
		END
		RETURN Ret
	END
END

Get Var Load
	return TBank.Load
End

Get Var Obtain
	Return TBank.Obtain
End
