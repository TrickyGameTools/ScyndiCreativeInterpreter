Module

class JCR6Entry
	readonly string Entry
	readonly int RealSize
	readonly int CompressedSize
	readonly string Storage
	
	Constructor(String E,int RS, int CS,String S)
		Entry,RealSize,CompressedSize,Storage = E,RS,CS,S
	End
End
	
Var GewoonNiks = Lua.SCI_InitAPI(Lua.SCI_StateName,"JCR6")

const delegate LoadDir = Lua.JCR6.GetJCR
const delegate LoadRealDir = Lua.JCR6.GetRealDir 
    

const delegate DirSize = Lua.JCR6.GetSize

//const delegate ActivateRealDir = Lua.JCR6.JCRActRealDir

Var DirIndex(int idx,string Tag="*MAIN")
	return Lua.JCR6.JCRGetEntry(idx,Tag)
end

Var DirEntry(int idx, string Tag="*MAIN")
	return New JCREntry(DirIndex(idx,Tag))
End

String GetString(string Ent,String Tag="*MAIN")
	return Lua.JCR6.JCRGetString(Tag,Ent)
End

String LoadString(string Ent,String Tag="*MAIN")
	return Lua.JCR6.JCRGetString(Tag,Ent)
End


// This function is officially deprecated, but I'll leave it here in case of
// serious conflicts.
Table GetLines_Old(string Ent,String Tag="*MAIN")
	Table Ret 
	Plua Src
	Src = GetString(Ent,Tag)
	Ret = {}
	Int Line = 0
	For i=1,Len(Src)
		Switch Mid(Src,i,1)
			Case "\r"
				// Do NOTHING
			Case "\n"
				if !Ret[Line]
					Ret[Line]=""
				end
				Line++
			Default
				Ret[Line] = sprintf("%s%s",Ret[Line] || "",Mid(Src,i,1))
		End
	End
	Return Ret
End

Table GetLines(string ent,String Tag="*MAIN")
	ret:={}
	int sz:=Lua.JCR6.JCRLines(-1,Tag,Ent)
	for i=0,sz-1
		ret[i]=Lua.JCR6.JCRLines(i)
	end
	return ret
end

Var Dir(String Directory,String Tag="*MAIN")
	plua Ret = {}
	plua fil
	Fil = Lua.JCR6.JCRFindFirst(Tag,Directory)
	While Fil
		Ret[Len(Ret)] = Fil
		Fil = Lua.JCR6.JCRFindNext()
	End
	Return Ret
End

Bool EntryExists(string Ent,string Tag="*MAIN")
	return Lua.JCR6.JCREntryExists(Tag,Ent)
End


Bool FileExists(string Ent,string Tag="*MAIN")
	return Lua.JCR6.JCREntryExists(Tag,Ent)
End

Bool DirExists(string WDir,string Tag="*MAIN")
	Return Lua.JCR6.JCRDirExists(Tag,WDir)
End

Bool DirectoryExists(string WDir,string Tag="*MAIN")
	Return Lua.JCR6.JCRDirExists(Tag,WDir)
End

Void Patch(String JFile,String Tag="*MAIN", String PDir="")
	Lua.JCR6.JCRPatch(Tag,JFile,PDir)
End

Void PatchRealDir(String JDir,String Tag="*MAIN", String PDir="",NoMerge)
	Lua.JCR6.JCRPatch(Tag,JDir,PDir,true,!NoMerge)
End

// Just never call this directly UNLESS you KNOW what you are doing!
LocExtern CoreWrite "JCR6.WriteCore"

Void Create(String OutFile, String Storage="Store", solid)
	CoreWrite(1,OutFile,Storage,solid==true && Storage!="Store")
End
Void AddString(String str,String Entry,String Author="",String Notes="")
	CoreWrite(2,Str,Entry,Author,Notes)
End
Void AddBank(bt,String Entry,String Author="",String Notes="")
	CoreWrite(3,Ternary(Lua.type(bt)=="string",bt,bt.Tag),Entry,Author,Notes)
End
Void Finalize()
	CoreWrite(0)
End
Void StoreTable(T,String OutFile, String Storage="Store", String Author="", String Notes="", solid)
	Create(OutFile,Storage,solid)
	For k,v in pairs(T)
		Lua.assert(Lua.type(k)=="string",sprintf("String expected for tablekey got %s(%s)",Lua.type(k),k))
		Lua.assert(Lua.type(v)=="string",sprintf("String expected for tablecontent got %s(%s)",Lua.type(v),v))
		AddString(v,k,Author,Notes)
	End
	Finalize()
End	